# ==============================================================================
# Environment Configuration - Student Information Management System (Backend)
# ==============================================================================

# Port for the Express REST API server (Render will set this automatically)
PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/studentDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://student_admin:YOUR_PASSWORD@cluster0.abcde.mongodb.net/studentDB?retryWrites=true&w=majority

# Authorized Frontend Origin for CORS (e.g. Netlify URL or local development)
# Local: http://localhost:3000, http://127.0.0.1:5500, http://localhost:8080
# Production: https://your-app-name.netlify.app
FRONTEND_URL=*

# Model Context Protocol (MCP) Server Configuration
# Secret key used for signing/verifying JWTs for RBAC on mutating student tools
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# Optional administrative API key for direct MCP tool access by LLM agents/backends
MCP_API_KEY=your-optional-admin-mcp-api-key

# Optional custom port for standalone MCP server (Render uses $PORT)
MCB_PORT=6000
